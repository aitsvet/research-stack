# Dockerfile
# Use a Debian base for full glibc compatibility
FROM debian:bookworm-slim

# Install essential packages
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    bash \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    vim \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Install OpenCode using the official script
RUN curl -fsSL https://opencode.ai/install | bash

# Add OpenCode to the PATH
ENV PATH="/root/.opencode/bin:${PATH}"

# Install Python language server (pyright)
RUN pip3 install --break-system-packages pyright uv jupyter nbconvert

# Create a non-root user
RUN useradd -m -u 1000 opencode

# Set up directories and permissions
RUN mkdir -p /work /home/opencode/.config/opencode && \
    chown -R opencode:opencode /work /home/opencode

# Switch to the non-root user
USER opencode
WORKDIR /work

# Default command (will be overridden by docker-compose)
ENTRYPOINT ["opencode"]
