# Web UI basic-auth (Selkies stream on :8888)
ZOTERO_USER=your_username
ZOTERO_PASSWORD=change_me

# Bearer token for the in-Zotero MCP plugin. Copy from
# Zotero -> Settings -> MCP Server plugin pane after first launch,
# or from config/.zotero/zotero/*.default/prefs.js (mcp.server.authToken).
ZOTERO_MCP_TOKEN=zmcp_paste_token_here

# Polite-pool identifiers for OpenAlex / Unpaywall / Crossref lookups
# (discover.py, retry_unpaywall.py, verify_refs.py). Unpaywall requires one.
OPENALEX_EMAIL=you@example.org
UNPAYWALL_EMAIL=you@example.org
