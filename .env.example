# Web UI basic-auth (Selkies stream on :8888)
ZOTERO_USER=your_username
ZOTERO_PASSWORD=change_me

# Bearer token for the in-Zotero MCP plugin. Copy from
# Zotero -> Settings -> MCP Server plugin pane after first launch,
# or from $ZOTERO_HOME/.zotero/zotero/*.default/prefs.js (mcp.server.authToken).
ZOTERO_MCP_TOKEN=zmcp_paste_token_here

# Zotero data dir: profile, library, attachments (mounted as /config). Kept
# outside the checkout so a fresh clone cannot lose it.
# ZOTERO_HOME=/home/you/zotero

# Polite-pool identifiers for OpenAlex / Unpaywall / Crossref lookups
# (discover.py, retry_unpaywall.py, verify_refs.py). Unpaywall requires one.
OPENALEX_EMAIL=you@example.org
UNPAYWALL_EMAIL=you@example.org

# --- Open WebUI + the qwen_auto pipe (see open-webui/README.md) ---
OWUI_PORT=4096
WEBUI_URL=http://localhost:4096
# Session secret: openssl rand -hex 24
WEBUI_SECRET_KEY=change_me

# Model Studio key. Two kinds of endpoint exist and they are NOT interchangeable:
# the general one (dashscope-intl.aliyuncs.com, key `sk-<hex>`, ~150 models) and
# a token-plan one (token-plan.<region>.maas.aliyuncs.com, key `sk-sp-<...>`,
# ~10 models under different names). The base URL must match the key, and model
# names must match the endpoint — compose defaults assume the token plan.
DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=   # override only when moving off the token plan
# DASHSCOPE_NATIVE_URL= # same host, root without /api/v1 — image models

# Docker volume holding Open WebUI's data; create it once with
# `docker volume create open-webui`, or name an existing one here.
# OPEN_WEBUI_VOLUME=open-webui

# Hide the built-in "Arena Model" entry from the model picker
ENABLE_EVALUATION_ARENA_MODELS=false

# --- Ollama (local GPU model runtime) ---
# Default sizing for a 16GB-VRAM card running qwen3.6:35b (~23GB of weights, so
# partially offloaded); raise only after reading real usage back from
# `docker compose exec ollama ollama ps`.
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_KEEP_ALIVE=30m
# Override only on non-Nvidia hardware or multi-GPU hosts:
# OLLAMA_GPU_DRIVER=nvidia
# OLLAMA_GPU_COUNT=1

# Selkies stream budget (Zotero web UI over the SSH tunnel). Defaults suit a
# thin tunnel; raise on a fast link.
# SELKIES_WIDTH=1024
# SELKIES_HEIGHT=768
# SELKIES_FPS=15
# SELKIES_MBPS=1
