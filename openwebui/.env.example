# --- Open WebUI ---
# Порт, который слушает контейнер в host-сети; за ним обычно nginx.
OWUI_PORT=3111
# Секрет сессий Open WebUI. Сгенерировать: openssl rand -hex 24
WEBUI_SECRET_KEY=change_me

# --- DashScope / Model Studio (ключ Qwen) ---
# Регион ключа обязан совпадать с базовым URL: intl-ключ ↔ dashscope-intl.
DASHSCOPE_API_KEY=sk-...
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# qwen-plus надёжно ищет в вебе (enable_search); у qwen3-max поиск де-факто не
# срабатывает даже с forced_search (проверено). Без поиска qwen3-max сильнее.
QWEN_TEXT_MODEL=qwen-plus
# QWEN_ENABLE_SEARCH=false   # выключить родной веб-поиск Alibaba (по умолч. вкл)
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_IMAGE_MODEL=qwen-image-2.0
QWEN_IMAGE_EDIT_MODEL=qwen-image-edit-plus

# --- учётка для install_function.sh (ставит пайп через API) ---
# Первый signup на пустом инстансе становится админом.
OWUI_URL=http://localhost:3111
OWUI_EMAIL=you@example.org
OWUI_PASSWORD=change_me
